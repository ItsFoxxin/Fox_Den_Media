# Fox Den Media 0.9.0 Ugreen rehearsal template.
# This is deliberately NOT production-ready. Every state path points at a copied
# rehearsal tree. Never point old and new writers at the same writable state.
FOXDEN_PUBLIC_ORIGIN=http://127.0.0.1:18080
FOXDEN_BIND_IP=127.0.0.1
FOXDEN_PORT=18080
FOXDEN_PUID=10001
FOXDEN_PGID=10001
TZ=America/New_York
FOXDEN_SECRETS_DIR=/volume2/docker/foxden-media-rehearsal/secrets
FOXDEN_RUNTIME_DIR=/volume2/docker/foxden-media-rehearsal/runtime
PORTAL_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/portal
PORTAL_AUTH_MODE=local
PORTAL_COOKIE_SECURE=false
PORTAL_MODULES_JSON=[{"id":"music","name":"Music","base_url":"http://music:8000","navigation_path":"/music/"},{"id":"media","name":"Movies & TV","base_url":"http://media:8010","navigation_path":"/media/"}]

# Production source identity was 1000005:1000004. Apply it only to copied state
# after verifying numeric ownership and ACL behavior in the rehearsal tree.
MUSIC_PUID=1000005
MUSIC_PGID=1000004
MUSIC_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/copied/music/config
MUSIC_STAGING_PATH=/volume2/docker/foxden-media-rehearsal/copied/music/staging
MUSIC_DOWNLOAD_PATH=/volume2/docker/foxden-media-rehearsal/copied/music/download-inbox
MUSIC_LIBRARY_PATH=/volume2/docker/foxden-media-rehearsal/synthetic-media/Music
MUSICBRAINZ_CONTACT=CHANGE_ME_OPERATOR_EMAIL

MEDIA_PUID=10001
MEDIA_PGID=10001
MEDIA_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/media/config
MEDIA_LIBRARY_PATH=/volume2/docker/foxden-media-rehearsal/synthetic-media/Video

# Production qBittorrent appdata survives, but no container or payload root was
# verified. Copy appdata here and replace the payload placeholder only after the
# offline recovery report identifies the stored save path.
QBIT_PUID=1000
QBIT_PGID=1000
QBIT_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/copied/qbittorrent
TORRENT_DATA_PATH=/CHANGE_ME_COPIED_TORRENT_PAYLOAD
QBIT_BIND_IP=127.0.0.1
QBIT_WEB_PORT=18081
QBIT_USERNAME=admin
QBIT_IMAGE=lscr.io/linuxserver/qbittorrent:5.3.0@sha256:75ecbb1c89ab7b0a21c4bde40b4820e4f1649d2d56d83b91913422155e8d2a5f

# Rehearse the exact installed Gluetun image first. The secret file is created
# separately under FOXDEN_SECRETS_DIR and is never stored in this environment.
GLUETUN_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/copied/gluetun
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.1@sha256:1a5bf4b4820a879cdf8d93d7ef0d2d963af56670c9ebff8981860b6804ebc8ab
WIREGUARD_ADDRESSES=CHANGE_ME_REHEARSAL_ADDRESS
WIREGUARD_PUBLIC_KEY=CHANGE_ME_REHEARSAL_PUBLIC_KEY
WIREGUARD_ENDPOINT_IP=CHANGE_ME_REHEARSAL_ENDPOINT
WIREGUARD_ENDPOINT_PORT=51820
GLUETUN_HEALTH_TARGET_ADDRESSES=cloudflare.com:443,github.com:443
GLUETUN_HEALTH_ICMP_TARGET_IPS=1.1.1.1,8.8.8.8

# When using direct docker compose with --profile browser.
# scripts/foxden.py overrides this value based on --browser.
REMOTE_BROWSER_URL=/server-browser/
BROWSER_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/browser
BROWSER_IMAGE=jlesage/firefox:v26.09.1@sha256:302aa068dcfa46a2d248771c998f67377383554df8940252caef42b99c13eb65

# Preserve Jellyfin 10.11 and its /media container path for the first copied-state
# rehearsal. This never mounts /volume2/jellyfin/config directly.
JELLYFIN_IMAGE=jellyfin/jellyfin:10.11@sha256:aefb67e6a7ff1debdd154a78a7bbb780fd0c873d8639210a7f6a2016ad2b35db
JELLYFIN_PUBLIC_URL=http://127.0.0.1:18096
JELLYFIN_INTERNAL_URL=http://jellyfin:8096
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_PUID=1004
JELLYFIN_PGID=100
JELLYFIN_CONFIG_PATH=/volume2/docker/foxden-media-rehearsal/copied/jellyfin/config
JELLYFIN_CACHE_PATH=/volume2/docker/foxden-media-rehearsal/copied/jellyfin/cache
JELLYFIN_MEDIA_PATH=/volume2/docker/foxden-media-rehearsal/synthetic-media
JELLYFIN_MEDIA_CONTAINER_PATH=/media
JELLYFIN_DRI_DEVICE=/dev/dri
JELLYFIN_VIDEO_GID=44
JELLYFIN_RENDER_GID=105
