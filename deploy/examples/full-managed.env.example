FOXDEN_PUBLIC_ORIGIN=https://media.example.invalid
FOXDEN_BIND_IP=127.0.0.1
FOXDEN_PORT=8080
FOXDEN_PUID=10001
FOXDEN_PGID=10001
TZ=America/New_York
FOXDEN_SECRETS_DIR=/srv/foxden-media/secrets
FOXDEN_RUNTIME_DIR=/srv/foxden-media/runtime
PORTAL_CONFIG_PATH=/srv/foxden-media/portal
PORTAL_AUTH_MODE=local
PORTAL_COOKIE_SECURE=true
PORTAL_MODULES_JSON=[{"id":"music","name":"Music","base_url":"http://music:8000","navigation_path":"/music/"},{"id":"media","name":"Movies & TV","base_url":"http://media:8010","navigation_path":"/media/"}]
MUSIC_CONFIG_PATH=/srv/foxden-media/music/config
MUSIC_STAGING_PATH=/srv/foxden-media/music/staging
MUSIC_DOWNLOAD_PATH=/srv/foxden-media/music/downloads
MUSIC_LIBRARY_PATH=/srv/media/music
MUSICBRAINZ_CONTACT=admin@example.invalid
MEDIA_CONFIG_PATH=/srv/foxden-media/media/config
MEDIA_LIBRARY_PATH=/srv/media/video
TORRENT_DATA_PATH=/srv/downloads
QBIT_CONFIG_PATH=/srv/appdata/qbittorrent
GLUETUN_CONFIG_PATH=/srv/appdata/gluetun
QBIT_BIND_IP=127.0.0.1
QBIT_WEB_PORT=8081
QBIT_USERNAME=admin
QBIT_IMAGE=lscr.io/linuxserver/qbittorrent:5.3.0@sha256:75ecbb1c89ab7b0a21c4bde40b4820e4f1649d2d56d83b91913422155e8d2a5f
GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.3
WIREGUARD_ADDRESSES=10.2.0.2/32
WIREGUARD_PUBLIC_KEY=CHANGE_ME_PUBLIC_KEY
WIREGUARD_ENDPOINT_IP=CHANGE_ME_ENDPOINT_IP
WIREGUARD_ENDPOINT_PORT=51820
BROWSER_CONFIG_PATH=/srv/foxden-media/browser
BROWSER_IMAGE=jlesage/firefox:v25.09.2
# Existing Jellyfin remains external. Put its API key in
# FOXDEN_SECRETS_DIR/jellyfin-api-key; never place the key in this file.
JELLYFIN_URL=http://192.0.2.20:8096

# After rehearsing migration with a COPY of the existing Jellyfin state, these
# enable the optional managed service with `--jellyfin`. Do not point this at
# the live config while the old Jellyfin instance is running.
# After cutover, set JELLYFIN_URL=http://jellyfin:8096 so Music refreshes the
# managed service over the private platform network. Keep the external URL during
# rehearsal if the existing production server remains the refresh target.
JELLYFIN_IMAGE=jellyfin/jellyfin:12.4
JELLYFIN_PUBLIC_URL=https://jellyfin.example.invalid
JELLYFIN_INTERNAL_URL=http://jellyfin:8096
JELLYFIN_TIMEOUT_SECONDS=4.0
JELLYFIN_PUID=10001
JELLYFIN_PGID=10001
JELLYFIN_CONFIG_PATH=/srv/foxden-media/jellyfin/config
JELLYFIN_CACHE_PATH=/srv/foxden-media/jellyfin/cache
JELLYFIN_MEDIA_PATH=/srv/media
JELLYFIN_MEDIA_CONTAINER_PATH=/media
JELLYFIN_MEMORY_LIMIT=4g
JELLYFIN_CPUS=4.0
