{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fox Den Media release lock v1 — structural schema, not security verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "source_sha",
    "compose_sha256",
    "platform",
    "profiles",
    "images",
    "services",
    "rollback",
    "publisher"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "compose_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "music",
          "media",
          "browser",
          "jellyfin",
          "managed"
        ]
      }
    },
    "images": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "platform",
          "platform_digest",
          "source_sha"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z0-9./_-]+@sha256:[0-9a-f]{64}$"
          },
          "platform": {
            "const": "linux/amd64"
          },
          "platform_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "nginx",
          "portal",
          "music",
          "media",
          "browser",
          "jellyfin",
          "gluetun",
          "qbittorrent"
        ]
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "lock_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "run_id",
        "source_sha"
      ],
      "properties": {
        "workflow": {
          "const": "ghcr-candidates.yml"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    }
  }
}
