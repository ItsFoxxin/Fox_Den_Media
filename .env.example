# Start from one of deploy/examples/*.env.example instead of editing Compose.
FOXDEN_PUBLIC_ORIGIN=http://127.0.0.1:8080
FOXDEN_BIND_IP=127.0.0.1
FOXDEN_PORT=8080
FOXDEN_PUID=10001
FOXDEN_PGID=10001
TZ=America/New_York
FOXDEN_APP_MEMORY_LIMIT=1g
FOXDEN_APP_CPUS=2.0
FOXDEN_INGRESS_MEMORY_LIMIT=256m
FOXDEN_INGRESS_CPUS=1.0
FOXDEN_SECRETS_DIR=/srv/foxden-media/secrets
FOXDEN_RUNTIME_DIR=/srv/foxden-media/runtime
PORTAL_CONFIG_PATH=/srv/foxden-media/portal
PORTAL_AUTH_MODE=local
PORTAL_MODULES_JSON=[]

# Optional managed Jellyfin profile. These values are ignored unless the
# jellyfin mode, --jellyfin, or --jellyfin-hwaccel is selected.
JELLYFIN_IMAGE=jellyfin/jellyfin:12.4
JELLYFIN_PUBLIC_URL=https://jellyfin.example.invalid
JELLYFIN_INTERNAL_URL=http://jellyfin:8096
JELLYFIN_TIMEOUT_SECONDS=4.0
JELLYFIN_PUID=10001
JELLYFIN_PGID=10001
JELLYFIN_CONFIG_PATH=/srv/foxden-media/jellyfin/config
JELLYFIN_CACHE_PATH=/srv/foxden-media/jellyfin/cache
JELLYFIN_MEDIA_PATH=/srv/media
JELLYFIN_MEDIA_CONTAINER_PATH=/media
JELLYFIN_MEMORY_LIMIT=4g
JELLYFIN_CPUS=4.0
# Optional Intel QSV/VA-API override. Inventory these on the Docker host first.
# JELLYFIN_DRI_DEVICE=/dev/dri
# JELLYFIN_RENDER_GID=107
# JELLYFIN_VIDEO_GID=44
